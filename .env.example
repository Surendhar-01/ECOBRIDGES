# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Required for Google Maps SDK.
MAPS_API_KEY=DEFAULT_MAPS_API_KEY

# SUPABASE_URL: Your Supabase project URL, e.g. https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY: Public anon/public key from Supabase Project Settings -> API.
# Until real values are provided, all real auth flows surface an honest
# "Auth provider not configured" error (no simulated success).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GOOGLE_WEB_CLIENT_ID: OAuth 2.0 Web client id used for Google Sign-In via
# Credential Manager (id_token is exchanged with Supabase Sign In With ID Token).
GOOGLE_WEB_CLIENT_ID=

# OTP_MODE: "demo" = on-device Demo OTP second factor after credential sign-in
# (shown in the app, no SMS). "sms" = real provider (see issuePendingOtp hook).
OTP_MODE=demo

# GROK_API_KEY: xAI Grok API key (https://console.x.ai).
# Copy your key into .env as GROK_API_KEY=... (never commit the real key).
GROK_API_KEY=
# XAI_API_KEY is an alias — official xAI SDKs expect this name.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4

